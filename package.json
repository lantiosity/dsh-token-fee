{
  "name": "@lantiosity/dsh-token-fee",
  "version": "0.1.0",
  "description": "Real-time per-session token cost for the DeepSeek Harness web GUI, with per-provider pricing and configurable peak/off-peak tariffs",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "token-cost",
    "pricing"
  ],
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lantiosity/dsh-token-fee.git"
  },
  "homepage": "https://github.com/lantiosity/dsh-token-fee#readme",
  "bugs": "https://github.com/lantiosity/dsh-token-fee/issues",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./pricing": "./lib/pricing.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "scripts/install.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/pricing.js && node --check lib/index.js && node --check lib/client.js && node --check scripts/install.mjs && node --check scripts/test-process.mjs",
    "test": "node scripts/test-pricing.mjs && node scripts/test-host.mjs && node scripts/test-client.mjs",
    "test:process": "node scripts/test-process.mjs",
    "verify": "npm run check && npm test && npm run test:process",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
